# Python önbellek ve derleme dosyaları
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Sanal ortam klasörleri
.venv/
venv/
ENV/

# Model ağırlıkları ve büyük checkpoint'ler (GitHub boyut sınırları için)
*.pt
*.ckpt
checkpoints/

# Veri setleri ve Binary Cache
data/*.txt
data/*.bin
data/*.tar.gz
data/*.json
# data_manifest.json ufak ve önemli bir kimlik kartı olduğu için Git'e girmeli:
!data/data_manifest.json

# Dinamik Laboratuvar Koşuları (Eğitim logları, ara grafikler ve denemeler)
runs/

# Releases (Kalıcı Sürüm Arşivi)
# Kodlar, README ve JSON'lar Git'te kalabilir; ancak dev model ağırlığı engellenir:
releases/**/model.pt

# IDE ve İşletim Sistemi dosyaları
.vscode/
.idea/
.DS_Store
Thumbs.db